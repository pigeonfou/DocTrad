DATABASE_URL=postgresql+psycopg://docutranslate:CHANGE_ME@127.0.0.1/docutranslate
SESSION_SECRET=GENERATE_64_RANDOM_HEX_CHARACTERS
RUNTIME_SECRET=GENERATE_A_SEPARATE_SECRET
COOKIE_SECURE=true
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DATA_ROOT=/var/lib/docutranslate
MODEL_ROOT=/opt/docutranslate/models/translation
UPLOAD_MAX_SIZE=104857600
OCR_BACKEND=tesseract
PADDLE_DET_ROOT=/opt/docutranslate/models/paddleocr/detection
PADDLE_REC_ROOT=/opt/docutranslate/models/paddleocr/recognition
DOCLING_MODEL_ROOT=/opt/docutranslate/models/docling
