[Unit]
Description=DocTrad worker
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=docutranslate
Group=docutranslate
WorkingDirectory=/opt/docutranslate/current
EnvironmentFile=/etc/docutranslate/docutranslate.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/docutranslate/current/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/docutranslate /var/cache/docutranslate
UMask=0077
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
